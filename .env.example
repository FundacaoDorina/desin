# Todas as variáveis abaixo ficam SÓ no servidor (funções em api/).
# Nunca use o prefixo VITE_ para elas: tudo que começa com VITE_ é embutido no JavaScript público.

# Rede da Fundação: IPs públicos (ou faixas CIDR) que entram sem senha, separados por vírgula.
# Ex.: 200.100.50.10, 2804:abcd:1234::/48   Vazio = todo mundo precisa da senha.
ALLOWED_IPS=

# Frase-senha para quem está fora da rede da Fundação (ex.: 4 palavras soltas).
# Vazio = acesso só pela rede da Fundação.
ACCESS_PASSWORD=
# Segredo que assina as sessões. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=

# App da Web do Apps Script (apps-script/plataforma.gs) que entrega as abas da planilha
APPS_SCRIPT_URL=
# Chave gerada pela função plataformaGerarChave no Apps Script
APPS_SCRIPT_KEY=
